# Copy to .env and fill in. .env is git-ignored.
ANTHROPIC_API_KEY=       # https://console.anthropic.com/  (required)
TICKETMASTER_API_KEY=    # https://developer.ticketmaster.com/  (free; concerts, theater, sports)
TMDB_API_KEY=            # https://www.themoviedb.org/settings/api  (free; movies)
